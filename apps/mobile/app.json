{
  "expo": {
    "name": "OpenPong",
    "slug": "openpong",
    "scheme": "openpong",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.openpong.mobile" },
    "android": { "package": "app.openpong.mobile" },
    "web": { "bundler": "metro", "name": "OpenPong — your table tennis, managed" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
