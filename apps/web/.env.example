# The dashboard's own server-side configuration. Copy to `.env.local` if you
# need to point it somewhere other than the local defaults. Nothing here is
# exposed to the browser: the BFF holds these values and mints the session.

# The OpenPong agent server (Hono + CopilotKit runtime).
# OPENPONG_SERVER_URL=http://localhost:8787

# The OmniPong domain service (Python/FastAPI) that owns ratings, matches and tournaments.
# OMNIPONG_SERVICE_URL=http://127.0.0.1:8000

# Shared secret for the domain service. Set the same value on both sides.
# OMNIPONG_SERVICE_TOKEN=

# Optional API key for the domain service's protected write routes.
# OMNIPONG_API_KEY=

# Required only when the OpenPong server runs in live mode.
# OPENPONG_ACCESS_KEY=

# Read-only fallback database for first run / demo (SQLite).
# OPENPONG_OMNIPONG_DB=/absolute/path/to/omnipong.db
# Seals the account bearer into the httpOnly cookie. Set this to a long random
# string in production so every dashboard instance can read the same session
# after a restart or a scale-out. Falls back to OPENPONG_ACCESS_KEY locally.
# OPENPONG_COOKIE_SECRET=

# The server must run with MULTI_TENANT=true for /login to issue accounts.
# With it unset the dashboard runs as the single local owner and never asks.
