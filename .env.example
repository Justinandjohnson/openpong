# OpenPong — copy to .env. Sample mode stays on localhost and uses fictional data.
# Every mode works without a CopilotKit Intelligence key; the key only enables Rich Threads.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true
# Rate limiting keys on the socket address. Set true only behind a reverse proxy that
# overwrites X-Forwarded-For; otherwise callers can spoof it.
# TRUST_PROXY=false

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OpenPong's agent runs on Google Gemini by default:
# MODEL=google/gemini-2.5-flash
# GOOGLE_API_KEY=
# Keyless public web search is enabled by default. Queries and task/chat context go to Parallel.
# Disable on the API and any separate task worker with WEB_SEARCH_ENABLED=false.
WEB_SEARCH_ENABLED=true
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# Optional Anthropic endpoint override; a trailing /v1 is stripped (the SDK adds /v1 itself):
# ANTHROPIC_BASE_URL=
# Optional Google AI endpoint override; a trailing /v1beta is stripped (the SDK adds /v1beta itself):
# GOOGLE_GENERATIVE_AI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.
# Providers whose /responses tool loop is incomplete (e.g. DeepSeek) can opt
# into the Chat Completions wire format instead:
# OPENAI_CHAT_COMPLETIONS=true

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# --- OpenPong: OmniPong domain service (Python) ---
# Table-tennis data (USATT / Stadium / omnipong.com ratings, tournaments, matches) comes
# from OmniPong's FastAPI service. OpenPong calls POST /agent/action there.
# OMNIPONG_SERVICE_URL=http://127.0.0.1:8000
# OMNIPONG_SERVICE_TOKEN=  # shared secret; the service rejects /agent/* without it
# Real tournament registration is OFF by default. Even when true, every signup
# still waits for a separate human approval in the app. Leave unset to never register.
# OMNIPONG_ALLOW_REAL_SIGNUP=false

# --- OpenPong: STADIUM league sync (stadiumtt.com, public pages, no login) ---
# Per-user league URLs normally come from onboarding (Settings -> League URLs).
# Set the two below only to give a fresh install a pre-filled default league.
# STADIUMTT_LEAGUE_URLS=            # comma-separated stadiumtt.com urls
# OMNIPONG_OWNER=                   # player name inside those leagues (default: profile/owner)

# --- OpenPong: relay + companion (drive the user's own browser, no stored credentials) ---
# The WRITE path (tournament registration and logged-in scraping) can drive the
# person's OWN already-logged-in Chrome through the relay + companion instead of
# storing a password anywhere. See docs/RELAY_ARCHITECTURE.md.
# Domain service (services/omnipong):
# OMNIPONG_BROWSER=local                    # local | relay. relay = no stored credentials.
# OMNIPONG_ALLOW_STORED_CREDENTIALS=false   # the legacy .credentials.json path is opt-in ONLY
# RELAY_URL=https://relay.example           # relay base URL (also read by the dashboard server)
# RELAY_TOKEN=                              # operator token; must equal the relay's RELAY_OPERATOR_TOKEN
# RELAY_OWNER=                              # the account/owner this single-owner service drives
# RELAY_PAIRING_TOKEN=                      # optional: pin a specific pairing token instead of RELAY_OWNER
# RELAY_PUBLIC_REGISTER_TOKEN=              # optional: pairing token of an always-on public companion (Tier-1 USATT)
# Relay server itself (services/omnipong/relay):
# RELAY_OPERATOR_TOKEN=                     # random 32+ chars; the control plane fails closed (503) without it
# RELAY_HOST=0.0.0.0
# RELAY_PORT=8765
# RELAY_PAIRINGS_FILE=                      # where minted pairing tokens persist (default: relay/pairings.json)
# RELAY_REGISTER_TOKENS_FILE=               # optional static {token: owner_id} map, merged at startup
# RELAY_IDLE_TTL_S=120
# RELAY_MAX_TTL_S=900
# RELAY_GATE_TTL_S=300
# Companion (services/omnipong/companion), run on the person's own computer:
# OPENPONG_CHROME_PROFILE_DIR=              # dedicated Chrome profile (never the everyday one)

# --- OpenPong: inbound SMS (Twilio) -------------------------------------------
# The webhook verifies X-Twilio-Signature and fails closed without an auth token.
# Point your Twilio number's "A message comes in" webhook at
# https://<your-host>/webhooks/twilio (override the signed host if you sit behind a proxy).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# TWILIO_PUBLIC_HOST=openpong.example.com
# TWILIO_PUBLIC_SCHEME=https

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# CopilotKit Intelligence is OPTIONAL. It enables Rich Threads only: cross-device
# conversation history, thread sync and replay. Without a key the API still boots,
# chat still streams, and tools still run, but conversations stay on the device.
# To enable it, create or select a project with the commands below, then keep the
# generated key server-only.
# npx copilotkit@latest login
# npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# CopilotKit SDK telemetry goes through the shared sink to PostHog, tagged OpenMuse.
# project select also writes CPK_TELEMETRY_ID: preserve that generated value and
# deploy it alongside CPK_INTELLIGENCE_API_KEY to link runtime usage to the account.
# Do not invent an identity or copy one from another project.
# CPK_TELEMETRY_ID=  # generated by the CLI; keep server-only
# Full funnel capture is the default; an explicit sample rate overrides it.
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Opt out of SDK telemetry with either flag (true or 1), then restart the API:
# COPILOTKIT_TELEMETRY_DISABLED=true
# DO_NOT_TRACK=1

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# Optional deployment name shared by API and worker. When unset, a new install keeps a random
# name in DATA_DIR; an install created before that keeps a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=  # e.g. from `openssl rand -hex 12`
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse
# Or run each owner's computer in an E2B Desktop sandbox instead of Docker
# (graphical desktop with internet access; see docs/COMPUTER.md):
# COMPUTER_PROVIDER=e2b-desktop  # default: docker
# E2B_API_KEY=  # server-only; required for e2b-desktop, never sent into the sandbox
# COMPUTER_DEPLOYMENT_ID is required for e2b-desktop: sandboxes are matched across the E2B team
# COMPUTER_E2B_TEMPLATE=desktop  # optional custom template built from "desktop"
# E2B_DOMAIN=  # only when not using the default E2B cluster

# Optional Jev interaction choices: off (default), sample scripted decisions, or live SDK.
JEV_MODE=off
# live sends the latest user message, agent-written context and candidate choices to TypeSafe;
# see docs/demos/jev-generative-ui.md#what-live-mode-sends-to-typesafe
# TYPESAFE_API_KEY=  # server-only; required for JEV_MODE=live
# JEV_MODEL=jev-1.13.0
